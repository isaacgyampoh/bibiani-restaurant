# Serves the built web app inside the private network; the shared Caddy in front terminates TLS.
# Same security headers as on Cloudflare (scripts/cloudflare/build.mjs).
{
	admin off
	auto_https off
}
:80 {
	root * /srv
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: {$SUPABASE_ORIGIN}; connect-src 'self' {$SUPABASE_ORIGIN} {$SUPABASE_WS_ORIGIN}; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	try_files {path} /index.html
	file_server
}
