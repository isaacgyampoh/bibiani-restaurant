# MY FOOD web host(s) -> the restaurant's own containers. Rendered by deploy.sh into the platform's
# caddy-sites directory (the platform's own site for the Supabase-compatible host is separate).
__WEB_HOSTS__ {
	import security_headers
	encode zstd gzip
	@api path /v1/* /health /health/*
	handle @api {
		reverse_proxy myfood-api:8787
	}
	handle {
		reverse_proxy myfood-web:80
	}
}
