# ---------------------------------------------------------------------------
# API server (apps/api). Copy to .env for local development. NEVER commit .env.
# ---------------------------------------------------------------------------

# Supabase project URL. Used to verify access tokens against the project's
# public signing keys (<SUPABASE_URL>/auth/v1/.well-known/jwks.json).
SUPABASE_URL=https://<project-ref>.supabase.co

# Public anon key. Only browser apps and the print agent use it (to sign in).
# It grants nothing on its own: browser roles have no table privileges.
SUPABASE_ANON_KEY=<anon key>

# Postgres connection for the API: the least-privilege `rp_api` login (migration 1000),
# NOT the postgres superuser. Server-side secret. Supavisor pooler, TRANSACTION mode (6543).
# Format: postgresql://rp_api.<project-ref>:<RP_API_PASSWORD>@<pooler-host>:6543/postgres
# DEV: generated by `pnpm dev:logins` (scripts/dev/configure-dev-logins.sh).
DATABASE_URL=

# Supabase SECRET key (sb_secret_...). Server-side only: the API uses it to create
# staff and device logins (Auth admin API). Never in apps/web or the print agent.
SUPABASE_SECRET_KEY=

# Database timeouts per transaction (ms). Production defaults; raise only for tests run far from the database.
DB_STATEMENT_TIMEOUT_MS=8000
DB_LOCK_TIMEOUT_MS=4000

DB_POOL_MAX=5
PORT=8787
APP_ENV=development

# ---------------------------------------------------------------------------
# DEV / tests only
# ---------------------------------------------------------------------------
# Privileged DEV login used by the hosted test suite and platform scripts (never by the API).
TEST_DATABASE_URL=
# Hosted tests refuse to run against any other project.
TEST_ALLOWED_PROJECT_REF=<dev project ref>

# ---------------------------------------------------------------------------
# Web app (apps/web). PUBLIC values only: they are compiled into the browser bundle.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
# Empty = same origin (/v1 proxied to the API in dev, routed by the host in prod)
VITE_API_URL=

# API: browser origins allowed to call it (comma-separated), when the web app is on another origin
ALLOWED_ORIGINS=
# Email domain for device logins created at pairing (never receives mail)
DEVICE_ACCOUNT_DOMAIN=devices.example.com
