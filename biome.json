{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!docs",
      "!supabase/.temp",
      "!**/playwright-report",
      "!**/test-results",
      "!deploy",
      "!perf-results",
      "!apps/desktop/app",
      "!apps/desktop/release",
      "!apps/desktop/app-printing",
      "!apps/desktop/release-printing",
      "!apps/desktop/electron-builder.printing.generated.json",
      "!.production-archives"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
