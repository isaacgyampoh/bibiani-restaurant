{
  "name": "@rp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/main.js --sourcemap --banner:js=\"import { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@rp/application": "workspace:*",
    "@rp/contracts": "workspace:*",
    "@rp/domain": "workspace:*",
    "@rp/infrastructure": "workspace:*",
    "hono": "4.13.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@rp/client-core": "workspace:*",
    "@rp/testing": "workspace:*",
    "jose": "6.2.12",
    "@supabase/supabase-js": "2.117.1"
  }
}
