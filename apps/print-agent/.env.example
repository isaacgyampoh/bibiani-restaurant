# Print agent (runs on an always-on machine on the restaurant LAN)
API_URL=https://api.example.com
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<public anon key>
# Issued when the agent device is paired (AUTH-03, not built yet). Never use a service-role key here.
AGENT_REFRESH_TOKEN=<device refresh token>
JOURNAL_FILE=.journal/print-journal.jsonl
# Latest rotated refresh token (mode 0600). Keep this directory on local disk, readable only by the service user.
AGENT_SESSION_FILE=.journal/agent-session.json
POLL_INTERVAL_MS=3000
AGENT_VERSION=0.1.0
